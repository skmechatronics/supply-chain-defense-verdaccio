# Naming — all other resource names are derived from these
prefix        = "vdcd"
location      = "australiaeast"
location_abbr = "ause"

# App Service
sku_name = "B1"

# IP allowlist — required, at least one CIDR range must be specified
# Use the client's office or VPN IP range
allowed_cidr_ranges = ["1.2.3.4/32"]
